# 环境变量示例
# 复制为 .env.local 并填入真实值。绝不提交 .env.local。

# ---------- Notion（内容源）----------
NOTION_TOKEN=

# 文章库（Blog Posts）
NOTION_BLOG_DATA_SOURCE_ID=

# 经济规划【公开脱敏库】Economy Public
# ⚠️ 注意：只填脱敏库的 ID，绝不能填私人 Economy Plan 库的 ID
NOTION_ECONOMY_PUBLIC_DATA_SOURCE_ID=

# ---------- Supabase（互动数据）----------
NEXT_PUBLIC_SUPABASE_URL=
# 匿名键：仅用于公开数据只读查询，所有写入走服务端 API
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------- 鉴权 ----------
# 生成方式：node scripts/hash-password.mjs（交互式，密码不进 shell history）
ADMIN_PASSWORD_HASH=
# 生成方式：openssl rand -base64 32
AUTH_SECRET=

# ---------- Webhook ----------
# Notion Webhook 签名校验密钥
# 生成方式：openssl rand -hex 24
NOTION_WEBHOOK_SECRET=

# ============================================================
# ❌ 以下变量禁止配置（check-env.mjs 会检测并直接报错退出）
#
# NOTION_ECONOMY_DATA_SOURCE_ID
#   旧变量名，指向【私人】经济库，会导致财务数据公开在站点上。
#   正确变量是上面的 NOTION_ECONOMY_PUBLIC_DATA_SOURCE_ID。
# ============================================================
