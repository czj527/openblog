# 环境变量示例
# 复制为 .env.local 并填入真实值。绝不提交 .env.local。

# ---------- Notion（内容源）----------
NOTION_TOKEN=
NOTION_BLOG_DATA_SOURCE_ID=
NOTION_ECONOMY_DATA_SOURCE_ID=

# ---------- Supabase（互动数据）----------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------- 鉴权 ----------
# 生成方式：node scripts/hash-password.mjs <你的密码>
ADMIN_PASSWORD_HASH=
# 生成方式：openssl rand -base64 32
AUTH_SECRET=

# ---------- Webhook ----------
# 生成方式：openssl rand -hex 24
REVALIDATE_SECRET=
